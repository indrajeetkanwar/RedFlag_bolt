# Copy this file to `.env` in the project root and fill in real values.
# `.env` is git-ignored; never commit real keys.

# --- Supabase (Phase 2) -------------------------------------------------------
# Supabase dashboard -> Project Settings -> API.
# The anon public key is safe in the browser: Row Level Security on the tables
# (supabase/migrations/) is the real access boundary, not key secrecy.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- AI provider (Phase 3) --------------------------------------------------
#   mock   -> src/lib/ai/mockProvider.ts, no network, file-name driven (local dev)
#   gemini -> src/lib/ai/geminiProvider.ts, calls the `extract-ride-details`
#             Supabase Edge Function (which holds the Gemini key server-side)
# Unset also means "mock".
VITE_AI_PROVIDER=mock

# --- NOT frontend env vars --------------------------------------------------
# The Gemini key is a *Supabase secret*, set with:
#   supabase secrets set GEMINI_API_KEY=...   (optionally GEMINI_MODEL=gemini-2.0-flash)
# It must never be prefixed VITE_ or placed in this file / the bundle.
