# Copy this file to `.env` in the project root and fill in real values.
# `.env` is git-ignored; never commit real keys.

# --- Supabase (Phase 2) -------------------------------------------------------
# Supabase dashboard -> Project Settings -> API.
# The anon public key is safe in the browser: Row Level Security on the tables
# (supabase/migrations/) is the real access boundary, not key secrecy.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- AI provider (Phase 3) --------------------------------------------------
#   mock   -> src/lib/ai/mockProvider.ts, no network, file-name driven (local dev)
#   gemini -> src/lib/ai/geminiProvider.ts, calls the `extract-ride-details`
#             Supabase Edge Function (which holds the Gemini key server-side)
# Unset also means "mock".
VITE_AI_PROVIDER=mock

# --- NOT frontend env vars (Supabase Edge Function secrets) ----------------
# Set with `npx supabase secrets set NAME=value`. Never VITE_, never in the bundle.
#   GEMINI_API_KEY   - from Google AI Studio (required)
#   GEMINI_MODEL     - optional, default gemini-2.5-flash
#   IP_HASH_SALT     - random hex, salts the ai_calls per-IP rate-limit hash
#   ALLOWED_ORIGIN   - the Vercel site URL; CORS allowlist for the functions
# See DEPLOYMENT.md.
