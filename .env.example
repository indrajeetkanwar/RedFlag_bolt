# Supabase connection (Phase 2)
# Copy this file to `.env` in the project root and fill in real values.
# Find both in the Supabase dashboard: Project Settings -> API.
# `.env` is git-ignored; never commit real keys.
#
# The anon public key is safe to ship to the browser: Row Level Security on the
# tables (see supabase/migrations/) is the actual access boundary, not key secrecy.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
